<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <!--
    Over 2 Over 3 Switch Under 6 Trader Bot.

    Trades Over 2. On a loss it moves to Over 3, and on a second loss it
    recovers with Under 6 - which is why the contract type is Both rather
    than Over: the third rung is an Under contract and a bot set to Over
    alone could not place it.

    This is the second build. The first followed the owner's own blocks
    closely, holding the three rungs in a Prediction list and indexing into
    it from a Start Information procedure, and it ran without ever placing a
    trade. Every structural check passed - the XML parsed, the block types
    were registered, the trade options matched a working bot's shape - so
    rather than keep testing theories against the owner's time, this build
    drops to blocks the nineteen working bots in this folder already prove:
    no list blocks, no procedure call, no lists_length, which between them
    were the only things here that nothing else in the folder used.

    The rungs are now a plain Prediction variable holding the digit itself,
    stepped by the loss counter, which is how Supatrader - a working
    Over/Under bot on the same contract type - carries its own prediction.

    Read off the owner's screenshots: market, trade type, contract type,
    candle interval, both restart-on-error flags, and the four opening
    values (Stake 30, Martangle 2 - their spelling - Take Profit 500,
    Consecutive Losses 4).

    Still specified rather than read: the win reset, the martingale step,
    the rung advance and both stop conditions. "4. Restart trading
    conditions" was collapsed in every screenshot bar the first line of its
    take-profit test.
  -->
  <variables>
    <variable id="v_stake">Stake</variable>
    <variable id="v_martangle">Martangle</variable>
    <variable id="v_take_profit">Take Profit</variable>
    <variable id="v_consecutive_losses">Consecutive Losses</variable>
    <variable id="v_initial_stake">Initial Stake</variable>
    <variable id="v_mart">Mart</variable>
    <variable id="v_prediction">Prediction</variable>
  </variables>

  <block type="trade_definition" id="trade_definition_root" deletable="false" x="0" y="60">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="td_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ75V</field>
        <next>
          <block type="trade_definition_tradetype" id="td_tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <!-- Both, not Over: the recovery rung buys Under 6. -->
              <block type="trade_definition_contracttype" id="td_contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="td_candle" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="td_restartbuysell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="td_restartonerror" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!--
      Set here rather than in a procedure. The first build called one, and a
      procedure call is another thing between the engine and a populated
      Prediction when the first proposal goes out.
    -->
    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_stake">
        <field name="VAR" id="v_stake" variabletype="">Stake</field>
        <value name="VALUE">
          <shadow type="math_number" id="init_stake_shadow"><field name="NUM">30</field></shadow>
          <block type="math_number" id="init_stake_num"><field name="NUM">30</field></block>
        </value>
        <next>
          <block type="variables_set" id="init_martangle">
            <field name="VAR" id="v_martangle" variabletype="">Martangle</field>
            <value name="VALUE">
              <shadow type="math_number" id="init_mt_shadow"><field name="NUM">2</field></shadow>
              <block type="math_number" id="init_mt_num"><field name="NUM">2</field></block>
            </value>
            <next>
              <block type="variables_set" id="init_take_profit">
                <field name="VAR" id="v_take_profit" variabletype="">Take Profit</field>
                <value name="VALUE">
                  <shadow type="math_number" id="init_tp_shadow"><field name="NUM">500</field></shadow>
                  <block type="math_number" id="init_tp_num"><field name="NUM">500</field></block>
                </value>
                <next>
                  <block type="variables_set" id="init_consecutive_losses">
                    <field name="VAR" id="v_consecutive_losses" variabletype="">Consecutive Losses</field>
                    <value name="VALUE">
                      <shadow type="math_number" id="init_cl_shadow"><field name="NUM">4</field></shadow>
                      <block type="math_number" id="init_cl_num"><field name="NUM">4</field></block>
                    </value>
                    <next>
                      <block type="variables_set" id="init_initial_stake">
                        <field name="VAR" id="v_initial_stake" variabletype="">Initial Stake</field>
                        <value name="VALUE">
                          <shadow type="math_number" id="init_is_shadow"><field name="NUM">30</field></shadow>
                          <block type="variables_get" id="init_get_stake">
                            <field name="VAR" id="v_stake" variabletype="">Stake</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="init_mart">
                            <field name="VAR" id="v_mart" variabletype="">Mart</field>
                            <value name="VALUE">
                              <shadow type="math_number" id="init_mart_shadow"><field name="NUM">1</field></shadow>
                              <block type="math_number" id="init_mart_num"><field name="NUM">1</field></block>
                            </value>
                            <next>
                              <!-- Rung one: Over 2. -->
                              <block type="variables_set" id="init_prediction">
                                <field name="VAR" id="v_prediction" variabletype="">Prediction</field>
                                <value name="VALUE">
                                  <shadow type="math_number" id="init_pred_shadow"><field name="NUM">2</field></shadow>
                                  <block type="math_number" id="init_pred_num"><field name="NUM">2</field></block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="td_tradeoptions">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number" id="duration_shadow"><field name="NUM">1</field></shadow>
          <block type="math_number" id="duration_num"><field name="NUM">1</field></block>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="amount_shadow"><field name="NUM">30</field></shadow>
          <block type="variables_get" id="get_stake_for_trade">
            <field name="VAR" id="v_stake" variabletype="">Stake</field>
          </block>
        </value>
        <value name="PREDICTION">
          <shadow type="math_number_positive" id="prediction_shadow"><field name="NUM">2</field></shadow>
          <block type="variables_get" id="get_prediction_for_trade">
            <field name="VAR" id="v_prediction" variabletype="">Prediction</field>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <!--
    Which side to buy. Rungs one and two are Over 2 and Over 3; the recovery
    rung is Under 6. Five is the dividing line, so the test holds whatever
    the rungs are changed to.
  -->
  <block type="before_purchase" id="before_purchase_root" deletable="false" x="0" y="620">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="pick_side">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="cmp_rung_is_under">
            <field name="OP">GTE</field>
            <value name="A">
              <block type="variables_get" id="get_prediction_for_side">
                <field name="VAR" id="v_prediction" variabletype="">Prediction</field>
              </block>
            </value>
            <value name="B">
              <block type="math_number" id="under_threshold"><field name="NUM">5</field></block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="purchase" id="purchase_under">
            <field name="PURCHASE_LIST">DIGITUNDER</field>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="purchase" id="purchase_over">
            <field name="PURCHASE_LIST">DIGITOVER</field>
          </block>
        </statement>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="after_purchase_root" deletable="false" x="0" y="760">
    <statement name="AFTERPURCHASE_STACK">
      <block type="notify" id="notify_result">
        <field name="NOTIFICATION_TYPE">success</field>
        <field name="NOTIFICATION_SOUND">silent</field>
        <value name="MESSAGE">
          <shadow type="text" id="notify_shadow"><field name="TEXT">Trade closed</field></shadow>
          <block type="total_profit" id="notify_total_profit"></block>
        </value>
        <next>
          <block type="controls_if" id="handle_result">
            <mutation else="1"></mutation>
            <value name="IF0">
              <block type="contract_check_result" id="is_win">
                <field name="CHECK_RESULT">win</field>
              </block>
            </value>

            <!-- A win goes back to the opening stake and rung one. -->
            <statement name="DO0">
              <block type="variables_set" id="win_reset_stake">
                <field name="VAR" id="v_stake" variabletype="">Stake</field>
                <value name="VALUE">
                  <block type="variables_get" id="get_initial_stake_win">
                    <field name="VAR" id="v_initial_stake" variabletype="">Initial Stake</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="win_reset_mart">
                    <field name="VAR" id="v_mart" variabletype="">Mart</field>
                    <value name="VALUE">
                      <shadow type="math_number" id="win_mart_shadow"><field name="NUM">1</field></shadow>
                      <block type="math_number" id="win_mart_num"><field name="NUM">1</field></block>
                    </value>
                    <next>
                      <block type="variables_set" id="win_reset_prediction">
                        <field name="VAR" id="v_prediction" variabletype="">Prediction</field>
                        <value name="VALUE">
                          <shadow type="math_number" id="win_pred_shadow"><field name="NUM">2</field></shadow>
                          <block type="math_number" id="win_pred_num"><field name="NUM">2</field></block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </statement>

            <!--
              A loss multiplies the stake and steps a rung. Mart counts the
              losses in a row: it reaches 2 after the first, so that is the
              Over 3 rung, and 3 or more after the second, which is Under 6
              and where it stays. The Consecutive Losses test below ends the
              run.
            -->
            <statement name="ELSE">
              <block type="variables_set" id="loss_scale_stake">
                <field name="VAR" id="v_stake" variabletype="">Stake</field>
                <value name="VALUE">
                  <block type="math_arithmetic" id="loss_multiply">
                    <field name="OP">MULTIPLY</field>
                    <value name="A">
                      <shadow type="math_number" id="loss_a_shadow"><field name="NUM">30</field></shadow>
                      <block type="variables_get" id="get_stake_loss">
                        <field name="VAR" id="v_stake" variabletype="">Stake</field>
                      </block>
                    </value>
                    <value name="B">
                      <shadow type="math_number" id="loss_b_shadow"><field name="NUM">2</field></shadow>
                      <block type="variables_get" id="get_martangle">
                        <field name="VAR" id="v_martangle" variabletype="">Martangle</field>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="math_change" id="loss_count_up">
                    <field name="VAR" id="v_mart" variabletype="">Mart</field>
                    <value name="DELTA">
                      <shadow type="math_number" id="loss_mart_shadow"><field name="NUM">1</field></shadow>
                      <block type="math_number" id="loss_mart_num"><field name="NUM">1</field></block>
                    </value>
                    <next>
                      <block type="controls_if" id="step_rung">
                        <mutation else="1"></mutation>
                        <value name="IF0">
                          <block type="logic_compare" id="cmp_mart_for_rung">
                            <field name="OP">GTE</field>
                            <value name="A">
                              <block type="variables_get" id="get_mart_for_rung">
                                <field name="VAR" id="v_mart" variabletype="">Mart</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number" id="rung_three_at"><field name="NUM">3</field></block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="variables_set" id="rung_under_six">
                            <field name="VAR" id="v_prediction" variabletype="">Prediction</field>
                            <value name="VALUE">
                              <shadow type="math_number" id="rung3_shadow"><field name="NUM">6</field></shadow>
                              <block type="math_number" id="rung3_num"><field name="NUM">6</field></block>
                            </value>
                          </block>
                        </statement>
                        <statement name="ELSE">
                          <block type="variables_set" id="rung_over_three">
                            <field name="VAR" id="v_prediction" variabletype="">Prediction</field>
                            <value name="VALUE">
                              <shadow type="math_number" id="rung2_shadow"><field name="NUM">3</field></shadow>
                              <block type="math_number" id="rung2_num"><field name="NUM">3</field></block>
                            </value>
                          </block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </statement>

            <!--
              Both ways the run ends. Stopping is simply not calling Trade
              again, which is how the other bots in this folder stop.
            -->
            <next>
              <block type="controls_if" id="continue_or_stop">
                <value name="IF0">
                  <block type="logic_operation" id="still_running">
                    <field name="OP">AND</field>
                    <value name="A">
                      <block type="logic_compare" id="cmp_take_profit">
                        <field name="OP">LT</field>
                        <value name="A">
                          <block type="total_profit" id="profit_for_take_profit"></block>
                        </value>
                        <value name="B">
                          <block type="variables_get" id="get_take_profit">
                            <field name="VAR" id="v_take_profit" variabletype="">Take Profit</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="logic_compare" id="cmp_consecutive_losses">
                        <field name="OP">LTE</field>
                        <value name="A">
                          <block type="variables_get" id="get_mart_for_stop">
                            <field name="VAR" id="v_mart" variabletype="">Mart</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="variables_get" id="get_consecutive_losses">
                            <field name="VAR" id="v_consecutive_losses" variabletype="">Consecutive Losses</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="trade_again" id="trade_again_block"></block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
